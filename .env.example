# Copie para .env (na raiz do repositório) e preencha. O .env nunca é versionado.
# Variáveis da Fase 1. Detalhes em ARCHITECTURE.md › "Configuração".

# --- Banco -------------------------------------------------------------------
# DSN do Postgres, usado quando o backend roda fora do Docker (uv run ...).
# Dentro do docker compose, o DATABASE_URL é montado pelo próprio compose.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/scarlet_scribe

# --- ClickUp (usuário bot, somente leitura) -----------------------------------
# Token pessoal do bot (começa com pk_). Nunca commite o valor real.
CLICKUP_API_TOKEN=
# Id do workspace a sincronizar (na API v2 o ClickUp chama workspace de "team").
CLICKUP_TEAM_ID=
# Ids de spaces separados por vírgula; vazio = todos os spaces.
CLICKUP_SPACE_IDS=
# Limite preventivo de requisições por minuto, por token.
CLICKUP_RATE_LIMIT_PER_MINUTE=100

# --- Sync ----------------------------------------------------------------------
SYNC_INTERVAL_MINUTES=10
SYNC_MANUAL_COOLDOWN_SECONDS=60
SYNC_FULL_RECONCILE_HOURS=24

# --- Docker Compose (opcional; os padrões abaixo já valem sem .env) -------------
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=scarlet_scribe
# POSTGRES_PORT=5432
# API_PORT=8000
