# Copie para .env (na raiz do repositório) e preencha. O .env nunca é versionado.
# Variáveis da Fase 1 e da Fase M. Detalhes em ARCHITECTURE.md › "Configuração" e › "Fase M".

# --- Banco -------------------------------------------------------------------
# DSN do Postgres, usado quando o backend roda fora do Docker (uv run ...).
# Dentro do docker compose, o DATABASE_URL é montado pelo próprio compose.
# Se mudar POSTGRES_PASSWORD, POSTGRES_DB ou POSTGRES_PORT (seção Docker Compose,
# no fim do arquivo), ajuste também este DATABASE_URL com os mesmos valores.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/scarlet_scribe

# --- ClickUp (usuário bot, somente leitura) -----------------------------------
# Token pessoal do bot (começa com pk_). Nunca commite o valor real.
CLICKUP_API_TOKEN=
# Id do workspace a sincronizar (na API v2 o ClickUp chama workspace de "team").
CLICKUP_TEAM_ID=
# Ids de spaces separados por vírgula; vazio = todos os spaces.
CLICKUP_SPACE_IDS=
# Limite preventivo de requisições por minuto, por token.
CLICKUP_RATE_LIMIT_PER_MINUTE=100

# --- GitLab (usuário bot, somente leitura; Fase M) ----------------------------
# gitlab.com ou o GitLab self-hosted da empresa, o que estiver disponível.
# Detalhes em ARCHITECTURE.md › "Fase M: multi-integração" › "GitLab".
# Endereço da instância, sem /api/v4 (ex.: https://gitlab.com).
GITLAB_URL=
# Token só com o escopo read_api, enviado no header PRIVATE-TOKEN.
# Nunca commite o valor real.
GITLAB_API_TOKEN=
# Ids de grupos e/ou de projetos separados por vírgula (ao menos um dos dois).
GITLAB_GROUP_IDS=
GITLAB_PROJECT_IDS=
# Só no self-hosted com certificado interno: caminho do bundle da CA. Vazio = CAs do sistema.
GITLAB_CA_BUNDLE=
# Limite preventivo de requisições por minuto; o valor final sai do spike (FM-03).
GITLAB_RATE_LIMIT_PER_MINUTE=

# --- Sync ----------------------------------------------------------------------
SYNC_INTERVAL_MINUTES=10
SYNC_MANUAL_COOLDOWN_SECONDS=60
SYNC_FULL_RECONCILE_HOURS=24

# --- Docker Compose (opcional; os padrões abaixo já valem sem .env) -------------
# Atenção: mudar POSTGRES_PASSWORD, POSTGRES_DB ou POSTGRES_PORT exige ajustar
# também o DATABASE_URL da seção Banco, que é o usado fora do Docker.
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=scarlet_scribe
# POSTGRES_PORT=5432
# API_PORT=8000
# Porta do frontend (servidor do Vite) exposta no host.
# FRONTEND_PORT=5173
