#!/usr/bin/env python3
"""git commit-msg: on agent branches the subject must start with the branch name,
e.g. 'conector/cliente-http: adiciona retries com backoff'. Merge commits are exempt."""

import subprocess
import sys
from pathlib import Path

ROOT = Path(subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True).strip())
sys.path.insert(0, str(ROOT / ".claude" / "hooks"))

from _common import repo_context  # noqa: E402


def main() -> int:
    ctx = repo_context(ROOT)
    if ctx is None or ctx.merging or ctx.agent in (None, "maestro"):
        return 0  # the branch itself is validated by pre-commit
    lines = [ln for ln in Path(sys.argv[1]).read_text().splitlines() if not ln.startswith("#")]
    subject = lines[0].strip() if lines else ""
    prefix = f"{ctx.branch}: "
    if not subject.startswith(prefix) or not subject[len(prefix):].strip():
        print(
            f"commit-msg: o assunto deve começar com '{prefix}' seguido da descrição.\n"
            f"Exemplo: '{prefix}descreve a mudança'. Recebido: '{subject}'",
            file=sys.stderr,
        )
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
